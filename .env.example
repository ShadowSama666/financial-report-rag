# 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，不会进 Git
# cp .env.example .env   (Windows: copy .env.example .env)

# 阶段五：DeepSeek 生成模型（必填）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 阶段四：本地 embedding 模型（可选覆盖，默认 Qwen/Qwen3-Embedding-0.6B）
# 若网络受限，可先手动下载模型后填本地绝对路径
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
HF_ENDPOINT=https://hf-mirror.com
# huggingface_hub 1.x 默认改用 xet CDN 传输权重，而镜像站没有该端点，
# 表现是"权重下到一半就不动了"。关掉 xet 退回经典 HTTP 下载即可正常续传。
HF_HUB_DISABLE_XET=1

# 阶段二：巨潮下载节流（秒）
REQUEST_INTERVAL=1.2
